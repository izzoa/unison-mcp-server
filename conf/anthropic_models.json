{
  "_README": {
    "description": "Model metadata for native Anthropic (Claude) API access.",
    "documentation": "https://github.com/izzoa/unison-mcp-server/blob/main/docs/custom_models.md",
    "usage": "Models listed here are exposed directly through the Anthropic provider. Aliases are case-insensitive and deliberately mirror the OpenRouter catalog's names so dual-key setups reroute to the direct API without retraining anyone.",
    "field_notes": "Matches providers/shared/model_capabilities.py.",
    "catalog_policy": "Latest two generations per family, with every point release of the current generation (verified against Anthropic's model list, 2026-10-25): Opus 5.5 + Opus 5 + Opus 4.8, Sonnet 5.5 + Sonnet 5 + Sonnet 4.6, Fable 5.1 + Fable 5, Haiku 5.5 + Haiku 4.5. The bare family aliases (opus, sonnet, fable, haiku, claude) follow the newest model; older models keep their version-pinned aliases. Undated model IDs are used on purpose: they track the latest snapshot and match LiteLLM's catalog keys exactly, so auto-discovery enrichment merges cleanly.",
    "field_descriptions": {
      "model_name": "The model identifier (undated alias, e.g. 'claude-opus-5-5')",
      "aliases": "Array of short names users can type instead of the full model name",
      "context_window": "Total number of tokens the model can process (input + output combined)",
      "max_output_tokens": "Maximum number of tokens the model can generate in a single response",
      "max_thinking_tokens": "Budget-thinking models only: maximum extended-thinking budget the provider will allocate; actual budgets are mode-scaled percentages of this and always leave output headroom inside max_tokens",
      "supports_extended_thinking": "Whether the model can think before answering",
      "supports_adaptive_thinking": "Whether the model takes adaptive thinking (thinking type 'adaptive', depth set by output_config.effort) instead of a budget_tokens budget. Claude 4.7 and later reject budget_tokens with a 400",
      "supports_temperature": "Whether the model accepts sampling parameters. Claude 4.7 and later reject temperature/top_p/top_k with a 400, so the provider omits them",
      "intelligence_score": "1-20 human rating used as the primary signal for auto-mode model ordering"
    }
  },
